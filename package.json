    "@effect/platform-node": "^4",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "effect": "^4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
